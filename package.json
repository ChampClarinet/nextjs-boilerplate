{
  "name": "nextjs-boilerplate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "prebuild": "bun scripts/generate-sw-version.mjs",
    "build": "cross-env IS_BUILD=true bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "check-types": "bunx tsc --noEmit",
    "prepare": "bun .husky/install.mjs",
    "format": "bunx prettier -w ."
  },
  "dependencies": {
